# Runtime
NODE_ENV=development
APP_ENV=staging
SYSTEM_VERSION=1.0.01
HOST=127.0.0.1
PORT=3000

# Cloud PostgreSQL (Neon, Supabase, Render, or Cloud SQL)
# Production providers require TLS; keep this value in deployment secrets.
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>?sslmode=require
DATABASE_POOL_MAX=10

# Firebase Admin SDK (server-only; never expose these to Vite)
# Use mock only for local/staging development. Production must use live.
FIREBASE_MODE=mock
FIREBASE_PROJECT_ID=<firebase-project-id>
FIREBASE_CLIENT_EMAIL=<firebase-admin-client-email>
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n<private-key>\n-----END PRIVATE KEY-----\n"

# Firebase Web SDK (public identifiers only)
VITE_FIREBASE_MODE=mock
VITE_FIREBASE_API_KEY=<web-api-key>
VITE_FIREBASE_AUTH_DOMAIN=<project-id>.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=<firebase-project-id>
VITE_FIREBASE_STORAGE_BUCKET=<project-id>.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=<messaging-sender-id>
VITE_FIREBASE_APP_ID=<web-app-id>

# API and provider configuration (server-only where applicable)
# Production requires one or more HTTPS origins; never use '*'.
ALLOWED_ORIGINS=http://localhost:5173
FLUTTERWAVE_SECRET_HASH=<webhook-secret-hash>
FLUTTERWAVE_ACTOR_USER_ID=<service-user-uuid>
# Set JWT_AUTH_ENABLED=true only if a JWT provider is added; Firebase is the current auth provider.
# JWT_AUTH_ENABLED=false
# JWT_SECRET=<jwt-signing-secret>

# Approved non-production seed input (set exactly one source; the command fails closed otherwise).
# SEED_INPUT_FILE=/secure/path/approved-seed.json
# SEED_INPUT_JSON={"approved":true,"branches":[{"code":"KLA-CENTRAL","name":"Kampala Central"}],"users":[{"id":"00000000-0000-4000-8000-000000000001","firebaseUid":"firebase-collector-1","email":"collector@example.test","displayName":"Field Collector","role":"collector","branchCode":"KLA-CENTRAL","status":"active"}],"loanProducts":[{"code":"STANDARD-UGX","name":"Standard microcredit","currency":"UGX","active":true}]}
# JSON structure: approved=true; branches use stable code/name; users use stable UUID id,
# unique firebaseUid, role (admin|manager|officer|collector|accountant), and optional branchCode;
# loanProducts use stable code/name and optional 3-letter currency/active.
# Optional collectorAssignments use officerFirebaseUid, existing clientId, branchCode,
# routeCode, effectiveFrom (YYYY-MM-DD), and optional effectiveTo.
