# Runtime
NODE_ENV=development
APP_ENV=staging
SYSTEM_VERSION=1.0.01
HOST=127.0.0.1
PORT=3000

# Cloud PostgreSQL (Neon, Supabase, Render, or Cloud SQL)
# Production providers require TLS; keep this value in deployment secrets.
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>?sslmode=require
DATABASE_POOL_MAX=10

# Firebase Admin SDK (server-only; never expose these to Vite)
# Use mock only for local/staging development. Production must use live.
FIREBASE_MODE=mock
FIREBASE_PROJECT_ID=<firebase-project-id>
FIREBASE_CLIENT_EMAIL=<firebase-admin-client-email>
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n<private-key>\n-----END PRIVATE KEY-----\n"

# Firebase Web SDK (public identifiers only)
VITE_FIREBASE_MODE=mock
VITE_FIREBASE_API_KEY=<web-api-key>
VITE_FIREBASE_AUTH_DOMAIN=<project-id>.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=<firebase-project-id>
VITE_FIREBASE_STORAGE_BUCKET=<project-id>.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=<messaging-sender-id>
VITE_FIREBASE_APP_ID=<web-app-id>

# API and provider configuration (server-only where applicable)
ALLOWED_ORIGINS=http://localhost:5173
FLUTTERWAVE_SECRET_HASH=<webhook-secret-hash>
FLUTTERWAVE_ACTOR_USER_ID=<service-user-uuid>
