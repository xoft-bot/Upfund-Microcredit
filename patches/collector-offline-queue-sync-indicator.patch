+:root {
+  color: #102a43;
+  background: #f4f7fb;
+  font-family: Inter, ui-sans-serif, system-ui, sans-serif;
+  font-synthesis: none;
+  text-rendering: optimizeLegibility;
+}
+
+* { box-sizing: border-box; }
+body { margin: 0; min-width: 320px; }
+.shell { min-height: 100vh; display: grid; place-items: center; padding: 1.25rem; }
+.card { width: min(100%, 42rem); background: white; border: 1px solid #d9e2ec; border-radius: 1rem; padding: clamp(1.5rem, 5vw, 3rem); box-shadow: 0 16px 45px rgba(16, 42, 67, .08); }
+.eyebrow { margin: 0 0 .75rem; color: #2f855a; font-size: .75rem; font-weight: 800; letter-spacing: .12em; }
+h1 { margin: 0; font-size: clamp(2rem, 8vw, 3.5rem); line-height: 1.05; }
+.lede { color: #486581; font-size: 1.08rem; line-height: 1.65; }
+.status { display: flex; align-items: center; gap: .6rem; margin: 1.5rem 0; padding: .8rem 1rem; border-radius: .75rem; background: #e6fffa; color: #14532d; font-weight: 700; }
+.status.offline { background: #fff5f5; color: #9b2c2c; }.auth-context { margin: 0; color: #486581; font-size: .9rem; font-weight: 700; }
+.dot { width: .65rem; height: .65rem; border-radius: 999px; background: #2f855a; }
+.note { color: #627d98; line-height: 1.6; }
+.footer { margin-top: 1.5rem; color: #829ab1; font-size: .75rem; font-weight: 700; letter-spacing: .04em; }
+
+.app-header { width: min(100%, 56rem); margin-bottom: 1rem; }
+.header-topline { display: flex; align-items: start; justify-content: space-between; gap: 1rem; }
+.sign-out-button { flex: 0 0 auto; min-height: 2.75rem; }
+.auth-card { margin-top: 1rem; }
+.auth-card h2 { margin: 0 0 .75rem; }
+.workflow-grid { width: min(100%, 56rem); display: grid; gap: 1rem; }
+.field-card, .receipt-card { background: #fff; border: 1px solid #d9e2ec; border-radius: 1rem; padding: 1rem; box-shadow: 0 10px 28px rgba(16, 42, 67, .06); }
+.field-card-heading, .receipt-toolbar, .action-row { display: flex; align-items: center; justify-content: space-between; gap: .75rem; }
+.field-card h2, .field-card h3, .receipt-card h2 { margin: 0 0 .75rem; }
+.network-pill, .status-badge { border-radius: 999px; padding: .35rem .65rem; font-size: .75rem; font-weight: 800; white-space: nowrap; }
+.network-pill.online, .status-badge.posted { background: #dcfce7; color: #166534; }
+.network-pill.offline, .status-badge.pending-reconciliation, .status-badge.needs-review { background: #fef3c7; color: #92400e; }
+.metric-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: .6rem; margin: 1rem 0; }
+.metric-grid div { background: #f4f7fb; border-radius: .75rem; padding: .7rem; }
+.queue-metrics { margin-top: .75rem; }
+.metric-grid span, .queue-list span, .variance-row small, .payment-evidence small { display: block; color: #627d98; font-size: .75rem; }
+.metric-grid strong { display: block; margin-top: .2rem; color: #102a43; }
