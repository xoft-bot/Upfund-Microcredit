{
  "name": "letsgrow-microcredit",
  "version": "1.0.01",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0 <22.0.0"
  },
  "packageManager": "pnpm@10.26.1",
  "scripts": {
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "PORT=${PORT:-3000} tsx server/src/index.ts",
    "dev:client": "vite --config client/vite.config.ts",
    "start": "NODE_ENV=production node dist/server/server/src/index.js",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "tsc -p tsconfig.json && npm run build:server && vite build --config client/vite.config.ts",
    "lint": "eslint client/src server/src shared tests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx server/src/db/migrate.ts",
    "db:check": "tsx server/src/db/check-schema.ts",
    "db:seed": "tsx server/src/db/seed.ts",
    "db:seed:defaults": "tsx server/src/db/seed-defaults.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.2",
    "@types/node": "^22.10.5",
    "fastify": "^5.12.1",
    "firebase": "^11.10.0",
    "firebase-admin": "^13.10.0",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "tsx": "^4.23.13",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  }
}
