run = "PORT=3001 npm run dev"
entrypoint = "client/src/main.tsx"
modules = ["nodejs-20", "nodejs-24", "postgresql-16", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["nano", "firebase-tools"]

[[ports]]
localPort = 5001
externalPort = 5001

[[ports]]
localPort = 3001
externalPort = 3001